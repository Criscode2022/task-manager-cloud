# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt

/.sourcemaps
/.versions

# Ionic / Angular web app
/.ionic
/www
apps/web/www
/platforms
/plugins

# Compiled output
/dist
apps/*/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
apps/*/node_modules
packages/*/node_modules
npm-debug.log
pnpm-debug.log*
yarn-error.log
# Local content-addressable store. pnpm can create this inside the repo on this volume.
.pnpm-store/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Turbo
.turbo

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
/.angular
apps/web/.angular
/.angular/cache
# Cache written by the Spartan CLI, which runs through Nx.
.nx/
.sass-cache/
/connect.lock
/coverage
apps/*/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db

# MCP server
mcp-server/.venv/

# Secrets: environment files, local MCP overrides, and editor files that can hold credentials.
# The shared MCP configs (.mcp.json, .vscode/mcp.json, and the links in .cursor/ and .antigravity/) stay committed.
.env
.env.*
.mcp.json.local
.claude/settings.local.json
*.pem
*.key
apps/web/src/environments/environment.local.ts
apps/web/src/environments/environment.prod.local.ts
apps/web/src/environments/*.local.ts
apps/web/src/ionicons-svg/

# Netlify
.netlify

# Vercel
.vercel

# macOS metadata written next to every file on exFAT and other non-Apple volumes
._*

# Impeccable review captures (dev only)
**/.impeccable/review/
