# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt

/.sourcemaps
/.versions
/coverage

# Ionic / Angular web app
/.ionic
/www
apps/web/www
/platforms
/plugins

# Compiled output
/dist
apps/*/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
apps/*/node_modules
packages/*/node_modules
npm-debug.log
yarn-error.log

# Turbo
.turbo

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/.angular
apps/web/.angular
/.angular/cache
.sass-cache/
/.nx
/.nx/cache
/connect.lock
/coverage
apps/*/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db

# MCP server
mcp-server/.venv/

# Environment files with secrets
.env
.env.local
.env.*.local
apps/web/src/environments/environment.local.ts
apps/web/src/environments/environment.prod.local.ts
apps/web/src/environments/*.local.ts
src/environments/environment.local.ts
src/environments/environment.prod.local.ts
src/environments/*.local.ts

# Netlify
.netlify

# Vercel
.vercel
.env*
