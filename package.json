{
  "name": "task-cloud",
  "version": "0.0.1",
  "private": true,
  "description": "Task Cloud monorepo — Ionic/Angular PWA + NestJS API",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo run start:dev --filter=@task-cloud/api --filter=@task-cloud/web --ui=stream",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@task-cloud/web",
    "build:api": "turbo run build --filter=@task-cloud/api",
    "start": "pnpm --filter @task-cloud/web start",
    "start:full": "turbo run start:dev --filter=@task-cloud/api --filter=@task-cloud/web --ui=stream",
    "api": "pnpm --filter @task-cloud/api start:dev",
    "config": "pnpm --filter @task-cloud/web run config",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci --filter=@task-cloud/web",
    "test:api": "pnpm --filter @task-cloud/api test:api",
    "lint": "turbo run lint",
    "lint:ci": "turbo run lint:ci --filter=@task-cloud/web"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  }
}
