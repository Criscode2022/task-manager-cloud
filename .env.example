# Neon / Nest API configuration (monorepo root)
# Copy this file to .env and fill in your actual values

# Neon Postgres connection string (server-side only — never expose to the browser)
# Dashboard: https://console.neon.tech → Project → Connection Details
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Frontend API base path/URL
# Local: /api (Angular proxy → Nest on API_PORT)
# Vercel: also /api — single project serves web + API from the same origin
API_BASE_URL=/api

# Nest API listen port (local). Vercel injects PORT automatically.
API_PORT=3001

# Auth secrets (REQUIRED for API) — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-long-random-secret
PIN_PEPPER=replace-with-another-long-random-secret

# Comma-separated browser origins allowed by CORS
# Include your Vercel web production URL after first deploy
ALLOWED_ORIGINS=https://task-cloud.netlify.app,http://localhost:4200,http://127.0.0.1:4200

# Allow https://*.vercel.app preview deployments (default true)
ALLOW_VERCEL_PREVIEWS=true

# Session lifetime in seconds (default 86400 = 24h)
SESSION_TTL_SECONDS=86400

# Auth endpoint rate limit (per IP)
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MS=900000

# MCP server PIN (set after create_user / register)
TASK_MANAGER_PIN=12345678