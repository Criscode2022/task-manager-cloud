# Neon Postgres connection string (same as the Angular app root .env)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Same secrets used by the Nest API (required for PIN lookup and JWT sessions)
PIN_PEPPER=replace-with-another-long-random-secret
JWT_SECRET=replace-with-long-random-secret
SESSION_TTL_SECONDS=86400

# --- Authentication (any one method is enough) ---

# 1) PIN — 8-digit PIN for task operations (set after create_user / register)
TASK_MANAGER_PIN=12345678

# 2) JWT — Nest-compatible access token from the login tool or POST /api/auth/login
# TASK_MANAGER_TOKEN=

# 3) API key — static key mapped to an existing user id
# MCP_API_KEY=replace-with-long-random-api-key
# MCP_API_KEY_USER_ID=1
# Or multiple keys as JSON or comma-separated key:user_id pairs:
# MCP_API_KEYS={"alice-key": 1, "bob-key": 2}

# Remote HTTP MCP clients (mobile / Edit Server URL): streamable-http on /mcp
# MCP_TRANSPORT=streamable-http
# MCP_PUBLIC_URL=https://your-host
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
